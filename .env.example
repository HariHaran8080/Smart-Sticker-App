# Server Port
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/stickerforge

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d

# Background Removal Provider
# Options: "local" (default fallback, uses smart segmentation) or "removebg"
BACKGROUND_REMOVAL_PROVIDER=local

# Optional External API Key (if using remove.bg)
# REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=uploads
